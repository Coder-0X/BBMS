# ─────────────────────────────────────────────────────────────────
# BloodBank LIS — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.example.com

# Database (PostgreSQL)
DB_NAME=bloodbank
DB_USER=bloodbank_user
DB_PASSWORD=LuckyCharm
DB_HOST=127.0.0.1
DB_PORT=5432

# Encryption key (AES-256-GCM) — 32 bytes as hex: openssl rand -hex 32
# If not set, falls back to a key derived from SECRET_KEY (dev only).
ENCRYPTION_KEY=

# Blind-index HMAC key — 32 bytes as hex: openssl rand -hex 32
BLIND_INDEX_KEY=

# HashiCorp Vault (optional — leave blank to use local key derivation in dev)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_PATH=bloodbank/kms

# Email (leave blank to use console backend in dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.example.com

# Session / security (values are in MINUTES)
SESSION_IDLE_TIMEOUT=30
SESSION_ABSOLUTE_TIMEOUT=480
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# Cron alert management command — run via system crontab, NOT a daemon:
# */15 * * * * /path/to/venv/bin/python /path/to/manage.py run_alerts >> /var/log/bloodbank/alerts.log 2>&1
